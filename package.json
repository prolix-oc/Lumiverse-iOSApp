{
  "name": "lumiverse-ios-app",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.md",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "build:ios-client": "bun run scripts/build-ios-client.ts",
    "test:ios-client": "bun run scripts/smoke-test-ios-client.ts",
    "probe:ios-native-cache": "bun run scripts/probe-ios-native-cache.ts",
    "check:ios-frame-pacing": "bun run scripts/check-ios-frame-pacing.ts",
    "check:ios-release": "python3 scripts/check-ios-release.py",
    "build": "bun run build:ios-client",
    "test": "bun run test:unit",
    "test:release": "python3 -m unittest discover -s scripts -p test_check_ios_release.py",
    "test:native": "bun run scripts/check-ios-native-regressions.ts",
    "test:browser-windows": "bun run scripts/check-ios-browser-windows.ts",
    "build:sounds": "bun run vendor/synthesize-notification-sound.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "bun test --isolate scripts",
    "test:backend": "bun test --isolate tests/integration",
    "test:ci": "bun run typecheck && bun run test:unit && bun run test:release && bun run test:backend"
  },
  "dependencies": {
    "fflate": "0.8.2",
    "sharp": "0.34.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@types/jsdom": "28.0.1",
    "bun-types": "1.4.2",
    "jsdom": "29.0.1",
    "typescript": "7.0.2"
  },
  "trustedDependencies": [
    "sharp"
  ]
}
